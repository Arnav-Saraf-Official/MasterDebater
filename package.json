{
	"name": "masterdebater",
	"private": true,
	"version": "0.0.6-beta.3",
	"type": "module",
	"main": "dist-electron/main.cjs",
	"scripts": {
		"dev": "vite dev",
		"dev:electron": "npm run build:electron-main && concurrently --kill-others \"npm run dev -- --port 5188 --host 127.0.0.1\" \"wait-on http://127.0.0.1:5188 && cross-env ELECTRON_DEV=true electron . --disable-features=AutofillServerCommunication\"",
		"build": "vite build",
		"build:electron-main": "node electron/build.mjs",
		"build:win-release": "vite build && npm run build:electron-main && electron-builder --win --publish always",
		"build:mac-release": "rm -rf dist/mac dist/mac-arm64 && vite build && npm run build:electron-main && electron-builder --mac --publish always",
		"build:linux-release": "vite build && npm run build:electron-main && electron-builder --linux --publish always",
		"build:win": "vite build && npm run build:electron-main && electron-builder --win",
		"build:mac": "vite build && npm run build:electron-main && electron-builder --mac",
		"build:linux": "vite build && npm run build:electron-main && electron-builder --linux",
		"release:beta": "node scripts/release.mjs prerelease",
		"release:prepatch": "node scripts/release.mjs prepatch",
		"release:patch": "node scripts/release.mjs patch",
		"release:preminor": "node scripts/release.mjs preminor",
		"release:minor": "node scripts/release.mjs minor",
		"release:premajor": "node scripts/release.mjs premajor",
		"release:major": "node scripts/release.mjs major",
		"postinstall": "electron-rebuild -f -w keytar"
	},
	"devDependencies": {
		"@electron/rebuild": "^4.0.4",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/express": "^5.0.6",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.3",
		"concurrently": "^9.0.1",
		"cross-env": "^7.0.3",
		"electron": "^35.7.5",
		"electron-builder": "^26.0.0",
		"esbuild": "^0.28.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0",
		"wait-on": "^8.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.14.0",
		"@supabase/supabase-js": "^2.105.1",
		"@types/dompurify": "^3.0.5",
		"docx": "^9.6.1",
		"dompurify": "^3.4.2",
		"dotenv": "^17.4.2",
		"electron-updater": "^6.8.3",
		"express": "^5.0.0",
		"keytar": "^7.9.0",
		"officeparser": "^6.1.1",
		"pdf-parse": "^2.4.5"
	}
}
