{
	"name": "masterdebater",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"main": "dist-electron/main.cjs",
	"scripts": {
		"dev": "vite dev",
		"dev:electron": "npm run build:electron-main && concurrently --kill-others \"npm run dev -- --port 5188\" \"wait-on http://localhost:5188 && cross-env ELECTRON_RUN_AS_NODE= ELECTRON_DEV=true electron .\"",
		"build": "vite build",
		"build:electron-main": "node electron/build.mjs",
		"build:electron": "vite build && npm run build:electron-main && electron-builder",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/express": "^5.0.6",
		"@types/node": "^22",
		"@vitest/browser-playwright": "^4.1.3",
		"concurrently": "^9.0.1",
		"cross-env": "^7.0.3",
		"electron": "^35.7.5",
		"electron-builder": "^26.0.0",
		"esbuild": "^0.28.0",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"playwright": "^1.59.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0",
		"wait-on": "^8.0.0"
	},
	"dependencies": {
		"@lucide/svelte": "^1.14.0",
		"@supabase/supabase-js": "^2.105.1",
		"docx": "^9.6.1",
		"express": "^5.0.0",
		"keytar": "^7.9.0",
		"officeparser": "^6.1.1",
		"pdf-parse": "^2.4.5"
	}
}
